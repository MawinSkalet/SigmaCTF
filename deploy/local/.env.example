# Generate fresh values with: python scripts/init-local.py
POSTGRES_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
FLAG_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://ctf.localhost:8080
CHALLENGE_DOMAIN=localhost
PUBLIC_WEB_PORT=8080
TCP_HOST=localhost
MAX_INSTANCES=10
# Set only after scripts/sandbox-firewall.sh is active on the Linux Docker host.
SANDBOX_FIREWALL_CONFIRMED=false
