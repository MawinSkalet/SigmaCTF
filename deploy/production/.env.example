# Copy to deploy/production/.env on the VM. Never commit the real file.
IMAGE_PREFIX=mawin82560
IMAGE_TAG=v1
JWT_SECRET=replace-with-unique-64-character-secret
FLAG_SECRET=replace-with-another-unique-64-character-secret
# Azure PostgreSQL: append ?sslmode=verify-full and use its DNS endpoint.
DATABASE_URL=postgres://sigma:replace-password@postgres:5432/sigma
REDIS_URL=redis://redis:6379
DOCKER_URL=http://socket-write:2375
APP_ORIGIN=https://ctf.example.com
CHALLENGE_DOMAIN=example.com
PUBLIC_WEB_PORT=443
PUBLIC_HTTPS=true
COOKIE_SECURE=true
TCP_HOST=tcp.example.com
MAX_INSTANCES=5
SANDBOX_FIREWALL_CONFIRMED=true
ADMIN_HANDLE=Maskung

# Google OAuth (Optional: Leave empty to disable Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
